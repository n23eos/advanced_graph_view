{
	"name": "graph-insight",
	"version": "0.5.0-beta.1",
	"description": "Advanced graph view plugin for Obsidian — explore large vaults as an interactive 3D graph with clusters, PageRank and metric-driven node encoding.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "vitest bench --run",
		"lint": "eslint src/",
		"verify": "npm run lint && npm run typecheck && npm test"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"graph",
		"graph-view",
		"knowledge-graph",
		"pagerank",
		"webgl",
		"pixijs",
		"visualization"
	],
	"author": "n23eos",
	"license": "MIT",
	"homepage": "https://github.com/n23eos/advanced_graph_view#readme",
	"bugs": {
		"url": "https://github.com/n23eos/advanced_graph_view/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n23eos/advanced_graph_view.git"
	},
	"devDependencies": {
		"@types/d3-force": "^3.0.10",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.7.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"d3-force-3d": "^3.0.6",
		"graphology": "^0.26.0",
		"graphology-communities-louvain": "^2.0.2",
		"graphology-metrics": "^2.4.0",
		"pixi.js": "^8.19.0"
	}
}
